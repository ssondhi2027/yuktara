# Supabase project (Settings → API). Leave blank to run on built-in demo data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# FastAPI backend on Render
VITE_API_URL=http://localhost:8000
# Show "Continue with Google" on Log in. Off by default so every account confirms a real email.
VITE_ENABLE_GOOGLE=false
