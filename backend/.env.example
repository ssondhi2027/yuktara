# Yuktara API settings. Copy to .env for local runs; set real values in Render.
# Placeholders only: never commit real values.

ENV=development

# Supabase pooler, SESSION mode (port 5432):
# Dashboard → Connect → Session pooler. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Project URL: Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co

# Optional, legacy projects only (HS256 JWT secret). Projects on signing keys use the JWKS instead.
SUPABASE_JWT_SECRET=

# Optional: only needed for POST /photos/upload-url. Server-side only, never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated, exact origins (no wildcards)
ALLOWED_ORIGINS=http://localhost:5173,https://<your-site>.netlify.app
